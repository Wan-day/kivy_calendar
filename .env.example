GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
KIVY_CALENDAR_DB_PATH=~/.local/share/kivy_calendar/kivy_calendar.db
BACKEND_API_TOKEN=
KIVY_CALENDAR_API_BASE_URL=http://127.0.0.1:8000
# Host IP the Docker Compose backend port is published on (docker/compose.yml).
# Use the VPN interface IP. Never 0.0.0.0; defaults to 127.0.0.1 if unset.
# Compose only reads it from this file when started with --env-file .env:
#   docker compose --env-file .env -f docker/compose.yml up -d --build
BACKEND_BIND_IP=127.0.0.1
